# Local settings for stock-analysis-tool.
# Copy to .env for local experiments. Do not commit real secrets.

STOCK_TOOL_DATABASE_PATH=data/processed/stock_data.sqlite
STOCK_TOOL_DEFAULT_PRICE_FILE=data/sample/sample_tw_prices_for_indicators.csv

# Optional future data-provider settings. Leave blank unless you wire a provider explicitly.
STOCK_TOOL_DATA_API_KEY=
STOCK_TOOL_DATA_API_BASE_URL=

# Optional evidence-linked research assistant. Leave empty to use the fully
# local deterministic research summary. Do not put real keys in this file.
STOCK_TOOL_AI_BASE_URL=
STOCK_TOOL_AI_API_KEY=
STOCK_TOOL_AI_MODEL=
